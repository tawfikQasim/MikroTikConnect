<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTrustedStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No trusted device saved yet."
        android:textStyle="bold"
        android:paddingBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/btnScan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Scan Networks" />

        <Button
            android:id="@+id/btnAutoConnect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Connect to Trusted" />
    </LinearLayout>

    <Button
        android:id="@+id/btnForget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Forget Trusted Device"
        android:paddingBottom="8dp" />

    <ListView
        android:id="@+id/lvNetworks"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
